# Copy to .env.local for launch_backend.sh. Keep credentials out of Git.
QUANT_API_KEY=
QUANT_API_TRUSTED_HOSTS=127.0.0.1,::1
QUANT_AI_MODEL_API_KEY=
QUANT_AI_ENDPOINT=
QUANT_AI_MODEL=
QUANT_AI_OPENAI_COMPATIBLE=1
# Market providers only: optional external-model calls remain explicit.
QUANT_DATA_OFFLINE=0
QUANT_PROVIDER_TIMEOUT=20
QUANT_PROVIDER_ATTEMPTS=2
QUANT_AUTOMATION_SCHEDULER_ENABLED=1
QUANT_WARM_MARKET_CACHE=1
